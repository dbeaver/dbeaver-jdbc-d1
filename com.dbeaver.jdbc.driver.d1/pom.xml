<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dbeaver.jdbc</groupId>
        <artifactId>jdbc-cloudflare-d1</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>com.dbeaver.jdbc.driver.d1</artifactId>
    <name>DBeaver Cloudflare D1 JDBC Driver</name>
    <description>JDBC driver for the Cloudflare D1 REST API.</description>
    <url>https://github.com/dbeaver/dbeaver-jdbc-cloudflare-d1</url>
    <packaging>eclipse-plugin</packaging>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>DBeaver Corp</name>
            <organization>DBeaver Corp</organization>
            <organizationUrl>https://github.com/dbeaver</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:dbeaver/dbeaver-jdbc-cloudflare-d1.git</connection>
        <developerConnection>scm:git:git@github.com:dbeaver/dbeaver-jdbc-cloudflare-d1.git</developerConnection>
        <url>git@github.com:dbeaver/dbeaver-jdbc-cloudflare-d1.git</url>
    </scm>
    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dist</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <stripClassifier>com.dbeaver.jdbc.driver.d1</stripClassifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>assemble-driver-dist</id>
                        <phase>package</phase>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dist</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes><include>*.jar</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                        <goals><goal>copy-resources</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-full-jar</id>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>junit:junit</exclude>
                                    <exclude>jmock:jmock</exclude>
                                </excludes>
                            </artifactSet>
                            <finalName>dbeaver-jdbc-cloudflare-d1-full-${project.version}</finalName>
                        </configuration>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
